{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Branding response",
  "type": "object",
  "required": [
    "name",
    "description",
    "logoUrl",
    "directions",
    "map",
    "contact",
    "address"
  ],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "logoUrl": {"type": "string", "minLength": 1},
    "directions": {"type": "string", "minLength": 1},
    "map": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": {"type": "number"},
        "longitude": {"type": "number"}
      },
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "required": ["name", "phone", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "phone": {"type": "string", "minLength": 11},
        "email": {"type": "string", "format": "email"}
      },
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "required": ["line1", "line2", "postTown", "county", "postCode"],
      "properties": {
        "line1": {"type": "string", "minLength": 1},
        "line2": {"type": "string", "minLength": 1},
        "postTown": {"type": "string", "minLength": 1},
        "county": {"type": "string", "minLength": 1},
        "postCode": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
